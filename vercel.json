{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...slug].js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "src": "/s/(.*)", "dest": "/api/s/[...token].js" },
    { "src": "^/website/?$", "dest": "/public/website.html", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "src": "/(.*)", "dest": "/public/$1", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } }
  ]
}
